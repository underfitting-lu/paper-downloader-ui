DOWNLOAD_DIR=./downloads
PAPER_SOURCE=both
BROWSER_PROFILE_DIR=./.browser-profile
IEEE_PROFILE_DIR=./.browser-profile/ieee
SCHOLAR_PROFILE_DIR=./.browser-profile/scholar

ARXIV_MAX_RESULTS=8
MAJOR_MAX_RESULTS=8
ORCID_MAX_PROFILES=5
ORCID_MAX_WORKS_PER_PROFILE=120
ARXIV_TIMEOUT_SECONDS=30
MIN_MATCH_SCORE=0.9
MANUAL_LOGIN_WAIT_SECONDS=120

ARXIV_USER_AGENT=paper-downloader/1.0 (mailto:your_email@example.com)
IEEE_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
SCHOLAR_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
MAJOR_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
ORCID_USER_AGENT=paper-downloader/1.0 (mailto:your_email@example.com)

IEEE_WAIT_SECONDS=60
SCHOLAR_WAIT_SECONDS=60
